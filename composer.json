{
    "name": "zackkitzmiller/tiny",
    "description": "A reversible base62-style ID obfuscator for modern PHP applications.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "base62",
        "ids",
        "obfuscation",
        "php",
        "tiny"
    ],
    "homepage": "https://github.com/zackkitzmiller/tiny-php",
    "authors": [
        {
            "name": "Jacob DeHart"
        },
        {
            "name": "Kyle Bragger"
        },
        {
            "name": "Zack Kitzmiller",
            "email": "zack@inrpce.com"
        }
    ],
    "support": {
        "issues": "https://github.com/zackkitzmiller/tiny-php/issues",
        "source": "https://github.com/zackkitzmiller/tiny-php"
    },
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "ZackKitzmiller\\Laravel5\\": "src/ZackKitzmiller/Laravel5/",
            "ZackKitzmiller\\": "src/ZackKitzmiller/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests/"
        ]
    },
    "bin": [
        "bin/genset"
    ],
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text",
        "check": [
            "@composer validate --strict",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
